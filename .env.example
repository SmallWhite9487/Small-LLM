# Create a .env file from this template. Do not commit your real API key.
GEMINI_API_KEY=replace_with_your_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flas

# The crawler runs until Ctrl+C, then Gemini filters the staged files.
CRAWL_DELAY_SECONDS=1
CRAWL_RATE_LIMIT_COOLDOWN_SECONDS=30
CRAWL_MAX_CHAPTERS=20000
CRAWL_MAX_DOWNLOAD_BYTES=999999999

GUTENDEX_TIMEOUT_SECONDS=15
GUTENDEX_RETRIES=3
GUTENDEX_FAILURE_COOLDOWN_SECONDS=30
GUTENDEX_RANDOM_MAX_PAGE=100